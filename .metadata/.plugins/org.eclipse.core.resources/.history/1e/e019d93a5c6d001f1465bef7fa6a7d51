#define toggle(register,pin)	register^=(1<<(pin))
#define get_value(register,pin) (register & (1<<pin))>>pin





int main(void)
{
	// enable clock of GPIOA and GPIOB
	set(RCC_APB2ENR,2);
	set(RCC_APB2ENR,3);


	GPIOA_CRL = 0;
	GPIOA_CRH = 0;
	GPIOB_CRL = 0;
	GPIOB_CRH = 0;

	// Configure A1 (input floating)
