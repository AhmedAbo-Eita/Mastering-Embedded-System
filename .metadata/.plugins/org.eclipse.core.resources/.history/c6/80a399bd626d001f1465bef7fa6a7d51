#include <stdint.h>

//enable clock Register for GPIOx (RCC_APB2ENR)

#define RCC_BASE 0x40021000
#define RCC_APB2ENR *((volatile uint32_t*) (RCC_BASE + 0X18))

// macros of GPIOA and GPIOB

#define GPIOA_BASE 0x40010800
#define GPIOB_BASE 0x40010C00

#define GPIOA_CRL *((volatile uint32_t*) (GPIOA_BASE + 0X00))
#define GPIOB_CRL *((volatile uint32_t*) (GPIOB_BASE + 0X00))

#define GPIOA_CRH *((volatile uint32_t*) (GPIOA_BASE + 0X04))
#define GPIOB_CRH *((volatile uint32_t*) (GPIOB_BASE + 0X04))

#define GPIOA_IDR *((volatile uint32_t*) (GPIOA_BASE + 0X08))
#define GPIOB_IDR *((volatile uint32_t*) (GPIOB_BASE + 0X08))

#define GPIOA_ODR *((volatile uint32_t*) (GPIOA_BASE + 0X0C))
#define GPIOB_ODR *((volatile uint32_t*) (GPIOB_BASE + 0X0C))

//macros of set, clear and reset
#define set(register,pin)		register|=(1<<(pin))
#define clear(register,pin)		register&=~(1<<(pin))
#define toggle(register, pin) 	register^= (1<<(pin))
#define get_value(register,pin) (register & (1<<pin))>>pin





int main(void)
{
	// enable clock of GPIOA and GPIOB
	set(RCC_APB2ENR,2);
	set(RCC_APB2ENR,3);



	//set pins A1,A13 as input
	GPIOA_CRL&= ~(0b11<<4);
	GPIOA_CRL|= (0b01<<6);  // input floating

	GPIOA_CRH&= ~(0b11<<20);
	GPIOA_CRH|= (0b01<<22);  // input floating



	// set pins  B1, B13 as output

	GPIOB_CRL&= ~(0b11<<6);
	GPIOB_CRL|= (0b01<<4);  // output push pull
	GPIOB_CRL&= ~(0b11<<22);
	GPIOB_CRL|= (0b01<<20);  // output push pull



	while(1){
		if(((GPIOA_IDR&(1<<1))>>1)==0)
		{
			toggle(GPIOB_ODR,13);
			while(get_value(GPIOA_IDR,1)==0);
		}

		if(get_value(GPIOA_IDR,13)==1)
		{
			clear(GPIOB_ODR,1);
		}
		else if(get_value(GPIOA_IDR,13)==0)
		{
			set(GPIOB_ODR,1);
		}


	}

}
